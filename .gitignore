# not committed -- it can be large and is reproducible from Assets/ + Packages/.
unity/SpatialViewerPlayer/Library/
unity/SpatialViewerPlayer/Temp/
unity/SpatialViewerPlayer/Logs/
unity/SpatialViewerPlayer/obj/
unity/SpatialViewerPlayer/Build/
unity/SpatialViewerPlayer/UserSettings/
unity/SpatialViewerPlayer/.vs/
unity/SpatialViewerPlayer/*.csproj
unity/SpatialViewerPlayer/*.sln
unity/SpatialViewerPlayer/dist/
