<%= form_with(model: [@project, @spatial_model], local: true, multipart: true, class: 'tabular') do |f| %>
  <div class="box tabular">
    <div class="form--field -required">
      <%= f.label :title, class: 'form--label' %>
      <div class="form--field-container">
        <%= f.text_field :title, required: true, class: 'form--text-field' %>
      </div>
    </div>

    <div class="form--field">
      <%= f.label :description, class: 'form--label' %>
      <div class="form--field-container">
        <%= f.text_area :description, rows: 4, class: 'form--text-area' %>
      </div>
    </div>

    <div class="form--field -required">
      <%= f.label :model_format, t('spatial_viewer.model_format'), class: 'form--label' %>
      <div class="form--field-container">
        <%= f.select :model_format, [
              ['glTF / GLB (3D Mesh)', 'glb'],
              ['OBJ / Wavefront (.obj — textures via .zip bundle)', 'obj'],
              ['3D Gaussian Splatting (.ply / .splat / .ksplat)', 'gaussian_splat'],
              ['IFC (BIM Model)', 'ifc']
            ], {}, class: 'form--select' %>
      </div>
    </div>

    <div class="form--field">
      <label class="form--label"><%= t('attributes.attachments') %></label>
      <div class="form--field-container">
        <input type="file" name="file" id="file" class="form--file-field" accept=".glb,.gltf,.obj,.ply,.splat,.ksplat,.ifc,.zip">
        <% if @spatial_model.model_attachment.present? %>
          <div class="text-muted small mt-1">
            Current file: <strong><%= @spatial_model.model_attachment.filename %></strong> (<%= @spatial_model.formatted_size %>)
          </div>
        <% end %>
        <p class="form--field-instructions">
          <%= t('spatial_viewer.upload_help') %>
        </p>
      </div>
    </div>

    <div class="form--field">
      <%= f.label :is_default, class: 'form--label' %>
      <div class="form--field-container">
        <%= f.check_box :is_default, class: 'form--check-box' %>
      </div>
    </div>
  </div>

  <div class="form--actions">
    <%= f.submit t('button_save'), class: 'button -primary' %>
    <%= link_to t('button_cancel'), project_spatial_models_path(@project), class: 'button' %>
  </div>
<% end %>
