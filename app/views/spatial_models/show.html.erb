<% html_title "#{@spatial_model.title} - 3D Viewer" %>

<div class="spatial-viewer-app" id="spatialViewerApp"
     data-api-url="<%= api_data_project_spatial_model_path(@project, @spatial_model) %>"
     data-csrf-token="<%= form_authenticity_token %>"
     data-max-model-mb="250"
     data-heavy-model-mb="40"
     data-custom-fields-by-type="<%= @custom_fields_by_type.to_json %>">

  <div class="spatial-toolbar">
    <div class="toolbar-section toolbar-title-group">
      <a href="<%= project_spatial_models_path(@project) %>" class="toolbar-btn" title="Back to models list">
        <i class="icon-arrow-left1"></i>
      </a>
      <span class="toolbar-model-title"><%= @spatial_model.title %></span>
      <span class="badge -primary"><%= @spatial_model.model_format.upcase %></span>
    </div>

    <div class="toolbar-section">
      <button type="button" class="toolbar-btn" id="btnHome" title="Reset Initial View (Home)">
        <i class="icon-home"></i>
      </button>
      <button type="button" class="toolbar-btn" id="btnFit" title="Fit to View">
        <i class="icon-zoom-in"></i>
      </button>
      <div class="toolbar-dropdown">
        <button type="button" class="toolbar-btn" id="btnViews" title="Preset Views">
          <i class="icon-op-view-threed"></i> Views <i class="icon-arrow-down1"></i>
        </button>
        <div class="toolbar-dropdown-menu" id="viewsDropdownMenu">
          <a href="#" data-view="top">Top View</a>
          <a href="#" data-view="front">Front View</a>
          <a href="#" data-view="right">Right View</a>
          <a href="#" data-view="iso">Isometric (3D Iso)</a>
        </div>
      </div>
    </div>

    <div class="toolbar-section toolbar-tools-group">
      <div class="toolbar-dropdown" id="navToolGroup" style="display:inline-flex;align-items:center;gap:4px;">
        <button type="button" class="toolbar-btn tool-btn" id="toolOrbit" title="Navigate — drag to orbit, scroll to zoom to cursor, W/A/S/D to move, R/F for up/down (Shift = faster)" data-tool="orbit">
          <i class="icon-cursor-move"></i> Navigate
        </button>
        <% if @can_set_start_view %>
          <button type="button" class="toolbar-btn" id="btnNavMenu" title="Set the view the model opens with">
            <i class="icon-arrow-down1"></i>
          </button>
          <div class="toolbar-dropdown-menu" id="navDropdownMenu">
            <a href="#" id="btnSetStartView"><i class="icon-milestone"></i> Set as start view</a>
            <a href="#" id="btnClearStartView"><i class="icon-delete"></i> Clear start view</a>
          </div>
        <% end %>
      </div>
      <button type="button" class="toolbar-btn tool-btn" id="toolPin" title="Place 3D Pin on Surface" data-tool="pin">
        <i class="icon-milestone"></i> 3D Pin
      </button>
      <button type="button" class="toolbar-btn tool-btn" id="toolDraw" title="Draw Polyline on 3D Mesh" data-tool="draw">
        <i class="icon-edit"></i> Draw on Mesh
      </button>
      <button type="button" class="toolbar-btn tool-btn" id="toolLasso" title="Lasso / Region Selection on Mesh" data-tool="lasso">
        <i class="icon-target"></i> Mesh Lasso
      </button>
      <button type="button" class="toolbar-btn tool-btn" id="toolMeasure" title="Measure 3D Distance" data-tool="measure">
        <i class="icon-ruler"></i> Measure
      </button>
      <button type="button" class="toolbar-btn text-danger" id="toolClear" title="Clear Active Drawing">
        <i class="icon-delete"></i>
      </button>
    </div>

    <div class="toolbar-section">
      <button type="button" class="toolbar-btn" id="btnSliceToggle" title="3D Section & Clipping Planes">
        <i class="icon-scissors"></i> Sections
      </button>
      <button type="button" class="toolbar-btn" id="btnWireframe" title="Toggle Wireframe">
        <i class="icon-grid"></i>
      </button>
      <button type="button" class="toolbar-btn" id="btnRender" title="Render quality: lighting, shadows, environment">
        <i class="icon-settings2"></i> Render
      </button>
      <button type="button" class="toolbar-btn" id="btnLayers" title="Show / hide model layers" style="display: none;">
        <i class="icon-copy"></i> Layers
      </button>
      <button type="button" class="toolbar-btn" id="btnAnnotationLabels" title="Show / hide annotation label cards">
        <i class="icon-comment"></i> Labels
      </button>
      <button type="button" class="toolbar-btn" id="btnVR" title="Enter VR" style="display: none;">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M21 6H3a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h5.2a2 2 0 0 0 1.7-.9l1.3-2c.3-.45.95-.45 1.25 0l1.3 2a2 2 0 0 0 1.7.9H21a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2zM7.5 14A2.5 2.5 0 1 1 10 11.5 2.5 2.5 0 0 1 7.5 14zm9 0a2.5 2.5 0 1 1 2.5-2.5 2.5 2.5 0 0 1-2.5 2.5z"/>
        </svg>
        VR
      </button>
      <button type="button" class="toolbar-btn" id="btnSidePanelToggle" title="Toggle Side Panel">
        <i class="icon-task"></i> Tickets & Annotations (<span id="annotationCountHeader"><%= @annotations.count %></span>)
      </button>
      <% if @unity_player_available %>
        <a href="<%= download_exe_project_spatial_model_path(@project, @spatial_model) %>" class="toolbar-btn" title="Download a standalone Windows app (Unity) with this model">
          <i class="icon-download"></i> Download as .exe
        </a>
      <% end %>
    </div>
  </div>

  <div class="spatial-main-container">
    <div class="spatial-viewport" id="spatialViewport">
      <div class="viewer-loader" id="viewerLoader">
        <div class="spinner"></div>
        <div class="loader-text" id="loaderText">Loading 3D model...</div>
      </div>

      <div class="render-panel" id="layerPanel" style="display: none; right: auto; left: 16px;">
        <div class="slicing-header">
          <span>Layers</span>
          <button type="button" class="close-btn" id="closeLayerBtn">&times;</button>
        </div>
        <div class="slicing-body" id="layerList"></div>
      </div>

      <div class="slicing-panel" id="slicingPanel" style="display: none;">
        <div class="slicing-header">
          <span>3D Section Planes</span>
          <button type="button" class="close-btn" id="closeSliceBtn">&times;</button>
        </div>
        <div class="slicing-body">
          <label>X Plane: <input type="range" id="clipX" min="-50" max="50" value="50" step="0.5"></label>
          <label>Y Plane: <input type="range" id="clipY" min="-50" max="50" value="50" step="0.5"></label>
          <label>Z Plane: <input type="range" id="clipZ" min="-50" max="50" value="50" step="0.5"></label>
          <button type="button" class="button -small" id="resetClipBtn">Reset Sections</button>
        </div>
      </div>

      <div class="render-panel" id="renderPanel" style="display: none;">
        <div class="slicing-header">
          <span>Render quality</span>
          <button type="button" class="close-btn" id="closeRenderBtn">&times;</button>
        </div>
        <div class="slicing-body">
          <label class="render-row">
            <span>Shadows</span>
            <select id="rqShadows" class="form-select">
              <option value="off">Off</option>
              <option value="hard">Hard</option>
              <option value="soft">Soft</option>
            </select>
          </label>
          <label class="render-row">
            <span>Tone mapping</span>
            <select id="rqTone" class="form-select">
              <option value="aces">Filmic (ACES)</option>
              <option value="reinhard">Reinhard</option>
              <option value="linear">Linear</option>
              <option value="none">None</option>
            </select>
          </label>
          <label class="render-row">
            <span>Background</span>
            <select id="rqBackground" class="form-select">
              <option value="light">Light</option>
              <option value="dark">Dark</option>
              <option value="studio">Studio</option>
            </select>
          </label>
          <label class="render-row -range">
            <span>Exposure <b id="rqExposureVal">1.0</b></span>
            <input type="range" id="rqExposure" min="0.2" max="2.5" step="0.05" value="1">
          </label>
          <label class="render-row -range">
            <span>Light intensity <b id="rqLightVal">1.0</b></span>
            <input type="range" id="rqLight" min="0.1" max="3" step="0.1" value="1">
          </label>
          <label class="render-row -check"><input type="checkbox" id="rqEnv"> Environment (sky) light</label>
          <label class="render-row -check"><input type="checkbox" id="rqHiDpi"> High-resolution (HiDPI)</label>
          <label class="render-row -check"><input type="checkbox" id="rqWireframe"> Wireframe</label>
          <label class="render-row -check"><input type="checkbox" id="rqGrid"> Ground grid</label>
          <button type="button" class="button -small" id="rqReset">Reset to defaults</button>
        </div>
      </div>

      <div class="drawing-tooltip" id="drawingTooltip" style="display: none;">
        Click on the mesh surface to place a point or drag to draw.
      </div>

      <canvas id="threeCanvas" class="three-canvas"></canvas>
    </div>

    <div class="spatial-side-panel" id="spatialSidePanel">
      <div class="side-panel-tabs">
        <button type="button" class="tab-btn active" data-tab="annotationsTab">3D Annotations</button>
        <button type="button" class="tab-btn" data-tab="workPackagesTab">Work Packages</button>
      </div>

      <div class="tab-content active" id="annotationsTab">
        <div class="annotations-list" id="annotationsList"></div>
      </div>

      <div class="tab-content" id="workPackagesTab">
        <div class="wp-list" id="workPackagesList"></div>
      </div>

      <%# Inline "New Work Package" panel — shown beside the viewer while
          creating an annotation, like the BCF split view. %>
      <div class="annotation-create-panel" id="annotationCreatePanel">
        <div class="create-panel-header">
          <h3 id="createPanelTitle">New Work Package</h3>
          <button type="button" class="close-btn" id="caCancelBtn" title="Cancel">&times;</button>
        </div>

        <div class="create-panel-body">
          <img id="caSnapshot" class="ca-snapshot" alt="Viewpoint snapshot">

          <div class="ca-mode-switch">
            <label><input type="radio" name="caMode" value="new" checked> New Work Package</label>
            <label><input type="radio" name="caMode" value="existing"> Link existing</label>
          </div>

          <div id="caNewGroup">
            <p class="create-panel-section">Details</p>
            <div class="form-group">
              <label>Subject *</label>
              <input type="text" id="caSubject" class="form-input" placeholder="Work Package subject">
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Type</label>
                <select id="caType" class="form-select">
                  <% @wp_types.each do |t| %>
                    <option value="<%= t.id %>" <%= 'selected' if t.is_default %>><%= t.name %></option>
                  <% end %>
                </select>
              </div>
              <div class="form-group">
                <label>Status</label>
                <select id="caStatus" class="form-select">
                  <option value="">Default</option>
                  <% @wp_statuses.each do |s| %>
                    <option value="<%= s.id %>" <%= 'selected' if s.is_default %>><%= s.name %></option>
                  <% end %>
                </select>
              </div>
            </div>

            <!-- Populated/replaced by JS on Type change -- see
                 _renderCustomFieldsForType in viewer_engine.js. -->
            <div id="caCustomFields"></div>

            <div class="form-group">
              <label>Description</label>
              <textarea id="caDesc" class="form-textarea" rows="4" placeholder="Description / notes"></textarea>
            </div>

            <p class="create-panel-section">People</p>
            <div class="form-row">
              <div class="form-group">
                <label>Assignee</label>
                <select id="caAssignee" class="form-select">
                  <option value="">Unassigned</option>
                  <% @wp_assignees.each do |u| %>
                    <option value="<%= u.id %>"><%= u.name %></option>
                  <% end %>
                </select>
              </div>
              <div class="form-group">
                <label>Accountable</label>
                <select id="caAccountable" class="form-select">
                  <option value="">Nobody</option>
                  <% @wp_assignees.each do |u| %>
                    <option value="<%= u.id %>"><%= u.name %></option>
                  <% end %>
                </select>
              </div>
            </div>

            <p class="create-panel-section">Classification</p>
            <div class="form-row">
              <div class="form-group">
                <label>Priority</label>
                <select id="caPriority" class="form-select">
                  <option value="">Default</option>
                  <% @wp_priorities.each do |p| %>
                    <option value="<%= p.id %>" <%= 'selected' if p.is_default %>><%= p.name %></option>
                  <% end %>
                </select>
              </div>
              <div class="form-group">
                <label>Category</label>
                <select id="caCategory" class="form-select">
                  <option value="">None</option>
                  <% @wp_categories.each do |c| %>
                    <option value="<%= c.id %>"><%= c.name %></option>
                  <% end %>
                </select>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Version</label>
                <select id="caVersion" class="form-select">
                  <option value="">None</option>
                  <% @wp_versions.each do |v| %>
                    <option value="<%= v.id %>"><%= v.name %></option>
                  <% end %>
                </select>
              </div>
              <div class="form-group">
                <label>Parent</label>
                <select id="caParent" class="form-select">
                  <option value="">None</option>
                  <% @work_packages.each do |wp| %>
                    <option value="<%= wp.id %>">#<%= wp.id %> - <%= wp.subject %></option>
                  <% end %>
                </select>
              </div>
            </div>

            <p class="create-panel-section">Scheduling</p>
            <div class="form-row">
              <div class="form-group">
                <label>Start date</label>
                <input type="date" id="caStartDate" class="form-input">
              </div>
              <div class="form-group">
                <label>Finish date</label>
                <input type="date" id="caDueDate" class="form-input">
              </div>
            </div>
            <div class="form-group">
              <label>Estimated time (h)</label>
              <input type="number" id="caEstimatedHours" class="form-input" min="0" step="0.25" placeholder="e.g. 4">
            </div>
          </div>

          <div id="caExistingGroup" style="display: none;">
            <div class="form-group">
              <label>Work Package</label>
              <select id="caExistingWp" class="form-select">
                <option value="">-- Select a Work Package --</option>
                <% @work_packages.each do |wp| %>
                  <option value="<%= wp.id %>">#<%= wp.id %> - <%= wp.subject %></option>
                <% end %>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label>Annotation colour</label>
            <div class="color-picker-group">
              <button type="button" class="color-dot active" data-color="#3b82f6" style="background:#3b82f6"></button>
              <button type="button" class="color-dot" data-color="#ef4444" style="background:#ef4444"></button>
              <button type="button" class="color-dot" data-color="#10b981" style="background:#10b981"></button>
              <button type="button" class="color-dot" data-color="#f59e0b" style="background:#f59e0b"></button>
              <button type="button" class="color-dot" data-color="#8b5cf6" style="background:#8b5cf6"></button>
            </div>
          </div>
        </div>

        <div class="create-panel-footer">
          <button type="button" class="button" id="caCancelBtn2">Cancel</button>
          <button type="button" class="button -primary" id="caSaveBtn">Create</button>
        </div>
      </div>

      <%# Annotation detail — full annotation + linked Work Package, both editable. %>
      <div class="annotation-detail-panel" id="annotationDetailPanel">
        <div class="create-panel-header">
          <button type="button" class="button -small" id="adBackBtn"><i class="icon-arrow-left1"></i> Annotations</button>
          <h3>Annotation</h3>
          <button type="button" class="close-btn" id="adCloseBtn" title="Close">&times;</button>
        </div>

        <div class="create-panel-body">
          <img id="adSnapshot" class="ca-snapshot" alt="Viewpoint snapshot">
          <div class="ad-meta">
            <span class="annotation-type-badge" id="adTypeBadge"></span>
            <span class="text-muted small" id="adAuthor"></span>
            <span class="text-muted small" id="adDate"></span>
          </div>

          <p class="create-panel-section">Annotation</p>
          <div class="form-group">
            <label>Title *</label>
            <input type="text" id="adTitle" class="form-input">
          </div>
          <div class="form-group">
            <label>Description</label>
            <textarea id="adDesc" class="form-textarea" rows="3"></textarea>
          </div>
          <div class="form-group" id="adAreaGroup" style="display:none;">
            <label>Area</label>
            <input type="text" id="adArea" class="form-input" readonly disabled title="Calculated automatically from the lasso selection's surface; recalculated whenever the selection changes.">
          </div>
          <div class="form-group">
            <label>Annotation colour</label>
            <div class="color-picker-group" id="adColorGroup">
              <button type="button" class="color-dot" data-color="#3b82f6" style="background:#3b82f6"></button>
              <button type="button" class="color-dot" data-color="#ef4444" style="background:#ef4444"></button>
              <button type="button" class="color-dot" data-color="#10b981" style="background:#10b981"></button>
              <button type="button" class="color-dot" data-color="#f59e0b" style="background:#f59e0b"></button>
              <button type="button" class="color-dot" data-color="#8b5cf6" style="background:#8b5cf6"></button>
            </div>
          </div>
          <div class="detail-actions">
            <button type="button" class="button -primary -small" id="adSaveAnnBtn">Save annotation</button>
          </div>

          <p class="create-panel-section">
            Work Package <b id="adWpNum"></b>
            <a id="adWpOpen" class="annotation-wp-link" target="_blank" rel="noopener" href="#"><i class="icon-relations"></i> Open</a>
          </p>
          <div id="adWpFields">
            <div class="form-group">
              <label>Subject</label>
              <input type="text" id="adWpSubject" class="form-input">
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Type</label>
                <select id="adWpType" class="form-select">
                  <% @wp_types.each do |t| %><option value="<%= t.id %>"><%= t.name %></option><% end %>
                </select>
              </div>
              <div class="form-group">
                <label>Status</label>
                <select id="adWpStatus" class="form-select">
                  <% @wp_statuses.each do |s| %><option value="<%= s.id %>"><%= s.name %></option><% end %>
                </select>
              </div>
            </div>

            <!-- Populated/replaced by JS on Type change -- see
                 _renderCustomFieldsForType in viewer_engine.js. -->
            <div id="adWpCustomFields"></div>

            <div class="form-group">
              <label>Description</label>
              <textarea id="adWpDesc" class="form-textarea" rows="3"></textarea>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Assignee</label>
                <select id="adWpAssignee" class="form-select">
                  <option value="">Unassigned</option>
                  <% @wp_assignees.each do |u| %><option value="<%= u.id %>"><%= u.name %></option><% end %>
                </select>
              </div>
              <div class="form-group">
                <label>Accountable</label>
                <select id="adWpAccountable" class="form-select">
                  <option value="">Nobody</option>
                  <% @wp_assignees.each do |u| %><option value="<%= u.id %>"><%= u.name %></option><% end %>
                </select>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Priority</label>
                <select id="adWpPriority" class="form-select">
                  <option value="">Default</option>
                  <% @wp_priorities.each do |p| %><option value="<%= p.id %>"><%= p.name %></option><% end %>
                </select>
              </div>
              <div class="form-group">
                <label>Category</label>
                <select id="adWpCategory" class="form-select">
                  <option value="">None</option>
                  <% @wp_categories.each do |c| %><option value="<%= c.id %>"><%= c.name %></option><% end %>
                </select>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Version</label>
                <select id="adWpVersion" class="form-select">
                  <option value="">None</option>
                  <% @wp_versions.each do |v| %><option value="<%= v.id %>"><%= v.name %></option><% end %>
                </select>
              </div>
              <div class="form-group">
                <label>Parent</label>
                <select id="adWpParent" class="form-select">
                  <option value="">None</option>
                  <% @work_packages.each do |wp| %><option value="<%= wp.id %>">#<%= wp.id %> - <%= wp.subject %></option><% end %>
                </select>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Start date</label>
                <input type="date" id="adWpStartDate" class="form-input">
              </div>
              <div class="form-group">
                <label>Finish date</label>
                <input type="date" id="adWpDueDate" class="form-input">
              </div>
            </div>
            <div class="form-group">
              <label>Estimated time (h)</label>
              <input type="number" id="adWpEstimatedHours" class="form-input" min="0" step="0.25">
            </div>
            <div class="detail-actions">
              <button type="button" class="button -primary -small" id="adSaveWpBtn">Save work package</button>
            </div>
          </div>

          <div class="detail-actions -danger">
            <button type="button" class="button -small text-danger" id="adDeleteBtn">Delete annotation</button>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>
